# Docusign eSignature REST API: send your first envelope
# Copy this file to .env and fill it in. Never commit .env.

# ── Your app, from Apps and Keys in your developer account ─────────────────
# The integration key (also called the client ID).
DOCUSIGN_INTEGRATION_KEY=
# A secret key you added to the same app. Docusign shows it once: copy it then.
DOCUSIGN_SECRET_KEY=
# Must match a redirect URI on the app exactly.
DOCUSIGN_REDIRECT_URI=http://localhost:3001/callback

# Developer accounts sign in here. Production uses https://account.docusign.com.
DOCUSIGN_AUTH_SERVER=https://account-d.docusign.com
# There is no base URI setting on purpose: the script reads base_uri from
# /oauth/userinfo, so the same code works in production.

# ── Who signs: use an inbox you can open ───────────────────────────────────
SIGNER_NAME=
SIGNER_EMAIL=

# ── Optional ───────────────────────────────────────────────────────────────
# Send your own PDF instead of documents/fontara-nda.pdf. Put \s1\ where the
# signature goes (white text hides it), or use --absolute.
# DOCUMENT_PATH=
